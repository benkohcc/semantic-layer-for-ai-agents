# Python environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Generated by the seeder and the indexer. Both are reproducible:
#   .venv/bin/python data/seed.py    rebuilds the warehouse and the documents
#   .venv/bin/python cli.py index    rebuilds the vector index
# Seeding is deterministic (fixed seed 42), so a clone regenerates byte-identical
# data rather than needing 52MB of binaries in the history.
baseline-tennis-poc/data/tennis_store.db
baseline-tennis-poc/data/chroma/
baseline-tennis-poc/data/documents/
baseline-tennis-poc/data/seed_facts.json

# Eval transcripts are run artifacts: they record what one model run did on one
# day, and they are regenerated by running the eval.
baseline-tennis-poc/eval/transcripts/

# OS and editor noise
.DS_Store
*.swp
.idea/
.vscode/
